# Copy to .env (never commit it) and fill in for production.
DATABASE_URL=postgres://eimsky:CHANGE_ME@db-host:5432/eimsky?sslmode=require
BASE_URL=https://app.eimsky.example
ADDR=:8080
DATA_DIR=/data
DEV_MODE=false
# 64 hex chars: openssl rand -hex 32. Keep it safe: it decrypts stored documents.
FILE_KEY=
COOKIE_SECURE=true

# Email (any SMTP provider)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Eimsky <no-reply@eimsky.example>

# SMS for forwarder sign-in codes: Eimsky POSTs {"to","message"} JSON here.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=

# Push notifications via Expo (access token optional unless enhanced security is on)
EXPO_ACCESS_TOKEN=
PUSH_ENABLED=true
JOBS_INTERVAL=30s
